<Window x:Class="DriverMasterPro.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DRIVER MASTER PRO" Height="740" Width="1160" MinHeight="580" MinWidth="850"
 WindowStartupLocation="CenterScreen" Background="#111923" Foreground="#F2F5F7">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="225"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#202A36" Padding="20">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="DRIVER" FontSize="25" FontWeight="Bold"/>
     <TextBlock Text="MASTER PRO" FontSize="19" Foreground="#25A56A" FontWeight="SemiBold"/>
     <TextBlock Text="Independent Windows Edition" Margin="0,4,0,28" FontSize="10" Foreground="#AAB6C2"/>
     <Button Content="Dashboard" Height="40" Background="#2D3A49" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12"/>
     <Button Content="Device inventory" Height="40" Margin="0,7,0,0" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock Text="Language / Sprache" Foreground="#AAB6C2" Margin="0,0,0,6"/>
     <ComboBox x:Name="LanguageBox" SelectedIndex="0" Height="32" SelectionChanged="LanguageBox_SelectionChanged">
      <ComboBoxItem Content="Deutsch"/>
      <ComboBoxItem Content="العربية"/>
     </ComboBox>
     <TextBlock Text="Version 0.2 — Read-only MVP" Margin="0,16,0,0" FontSize="10" Foreground="#AAB6C2"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1" Margin="26">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <Grid Grid.Row="0">
    <StackPanel HorizontalAlignment="Left">
     <TextBlock x:Name="PageTitle" Text="System Dashboard" FontSize="27" FontWeight="Bold"/>
     <TextBlock x:Name="PageSubtitle" Text="Lokale Geräteübersicht — keine Änderungen am System" Foreground="#AAB6C2" Margin="0,5,0,0"/>
    </StackPanel>
    <Button x:Name="ScanButton" Content="Jetzt scannen" Click="ScanButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,10" Background="#25A56A" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
   </Grid>

   <UniformGrid Grid.Row="1" Columns="3" Margin="0,22,0,18">
    <Border Background="#202A36" CornerRadius="9" Padding="16" Margin="0,0,10,0">
     <StackPanel>
      <TextBlock x:Name="DevicesLabel" Text="Erkannte Geräte" Foreground="#AAB6C2"/>
      <TextBlock x:Name="DeviceCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
    <Border Background="#202A36" CornerRadius="9" Padding="16" Margin="5,0">
     <StackPanel>
      <TextBlock x:Name="HealthyLabel" Text="Ohne gemeldeten Fehler" Foreground="#AAB6C2"/>
      <TextBlock x:Name="HealthyCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
    <Border Background="#202A36" CornerRadius="9" Padding="16" Margin="10,0,0,0">
     <StackPanel>
      <TextBlock x:Name="ProblemLabel" Text="Gemeldete Probleme" Foreground="#AAB6C2"/>
      <TextBlock x:Name="ProblemCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
   </UniformGrid>

   <Border Grid.Row="2" Background="#202A36" CornerRadius="9" Padding="10" Margin="0,0,0,10">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="SearchLabel" Text="Suche:" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBox x:Name="SearchBox" Width="260" Height="30" Padding="6,4" TextChanged="SearchBox_TextChanged"/>
     <TextBlock x:Name="FilterLabel" Text="Filter:" VerticalAlignment="Center" Margin="20,0,8,0"/>
     <ComboBox x:Name="FilterBox" Width="190" Height="30" SelectedIndex="0" SelectionChanged="FilterBox_SelectionChanged">
      <ComboBoxItem Content="Alle Geräte"/>
      <ComboBoxItem Content="Nur mit Problemen"/>
      <ComboBoxItem Content="Ohne Probleme"/>
     </ComboBox>
    </StackPanel>
   </Border>

   <Border Grid.Row="3" Background="#202A36" CornerRadius="9" Padding="12">
    <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#202A36" Foreground="#F2F5F7" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowBackground="#202A36" AlternatingRowBackground="#263342">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Gerät" Binding="{Binding Name}" Width="2*"/>
      <DataGridTextColumn Header="Hersteller" Binding="{Binding Manufacturer}" Width="*"/>
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
      <DataGridTextColumn Header="Problemcode" Binding="{Binding ProblemCode}" Width="*"/>
      <DataGridTextColumn Header="Bewertung" Binding="{Binding Health}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </Border>

   <TextBlock x:Name="StatusText" Grid.Row="4" Text="Bereit. Bitte zuerst einen Scan starten." Foreground="#AAB6C2" Margin="2,11,0,0"/>
  </Grid>
 </Grid>
</Window>
